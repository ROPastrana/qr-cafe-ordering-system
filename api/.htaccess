# Security headers on every API response
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    # PHP may send its own Cache-Control (sessions, track.php); keep just one
    Header unset Cache-Control
    Header always set Cache-Control "no-store"

    # The menu is the same for everyone and changes rarely: browsers may reuse it for 60 s.
    # <Files> is applied after the lines above, so this replaces no-store for menu.php only.
    <Files "menu.php">
        Header always set Cache-Control "public, max-age=60"
    </Files>
</IfModule>

# Don't list the files in /cafe/api/
Options -Indexes

# The database login is only loaded with require (from disk), never opened in a browser.
# The classes in src/ are blocked by src/.htaccess.
<FilesMatch "^(db|db\.example)\.php$">
    Require all denied
</FilesMatch>
